---
const whatsappUrl = 'https://wa.me/34688956540';
const instagramUrl = 'https://instagram.com/capicuapetstore';
const googleReviewUrl = 'https://www.google.com/maps/place/?q=Cap+i+Cua+Pet+Store+Esplugues&review=1';
---

<section id="contacto" class="relative py-20 sm:py-28 overflow-hidden bg-gradient-to-br from-brand-teal/5 via-white to-brand-yellow/5">
  <div class="absolute top-0 left-0 w-72 h-72 bg-brand-teal/[0.04] rounded-full -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-brand-yellow/[0.04] rounded-full translate-x-1/2 translate-y-1/2"></div>

  <div class="relative max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <span class="inline-block px-4 py-1.5 mb-4 text-sm font-semibold text-brand-teal bg-brand-teal/10 rounded-full">
        Contacto
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-brown">
        ¡Estamos aquí para ayudarte!
      </h2>
      <p class="mt-4 text-brand-brown/60 text-lg">
        Respondemos tus dudas, concertamos citas y agradecemos tu opinión en Google.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-[76rem] mx-auto">
      <!-- WhatsApp Card -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative bg-white rounded-2xl border-2 border-brand-teal/20 p-8 antigravity-hover reveal"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-brand-teal/5 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-green-600" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.523 3.656 1.423 5.157L2 22l5.006-1.389A9.956 9.956 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.62 0-3.12-.506-4.347-1.363l-.311-.196-2.97.824.796-2.896-.204-.324A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-brand-brown mb-2">WhatsApp</h3>
          <p class="text-brand-brown/60 mb-4">Respuesta rápida en minutos</p>
          <span class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 text-white font-semibold rounded-xl hover:bg-green-600 transition-colors duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            +34 688 95 65 40
          </span>
        </div>
      </a>

      <!-- Instagram Card -->
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative bg-white rounded-2xl border-2 border-brand-yellow/20 p-8 antigravity-hover reveal"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-brand-yellow/5 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-yellow-400 via-pink-500 to-purple-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-brand-brown mb-2">Instagram</h3>
          <p class="text-brand-brown/60 mb-4">Síguenos para ver nuestro trabajo</p>
          <span class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-yellow-400 via-pink-500 to-purple-600 text-white font-semibold rounded-xl hover:opacity-90 transition-opacity duration-300">
            @capicuapetstore
          </span>
        </div>
      </a>

      <!-- Google Review Card -->
      <a
        href={googleReviewUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative bg-white rounded-2xl border-2 border-brand-brown/15 p-8 antigravity-hover reveal"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-brand-brown/5 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8" viewBox="0 0 48 48">
              <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
              <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
              <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
              <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-brand-brown mb-2">Google</h3>
          <p class="text-brand-brown/60 mb-4">Ayúdanos con tu opinión</p>
          <span class="inline-flex items-center gap-2 px-6 py-3 bg-brand-brown text-white font-semibold rounded-xl hover:bg-brand-brown/90 transition-colors duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
            Dejar reseña
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

<script>
  const revealElements = document.querySelectorAll('#contacto .reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );
  revealElements.forEach((el) => revealObserver.observe(el));
</script>
