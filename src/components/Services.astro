---

<section id="servicios" class="relative overflow-hidden bg-brand-paper py-20 sm:py-28">
  <div class="relative max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center reveal">
      <span class="section-kicker">
        Nuestros servicios
      </span>
      <h2 class="font-display text-4xl font-black leading-none tracking-[-0.04em] text-brand-ink sm:text-6xl">
        Todo lo que tu mascota necesita
      </h2>
      <p class="mt-5 text-lg font-semibold text-brand-ink/65">
        En Cap i Cua ofrecemos un trato personalizado y profesional para que tu compañero salga feliz y radiante.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <article
          tabindex="0"
          class="ticket-cut group relative min-h-[24rem] cursor-default overflow-hidden border-2 border-brand-teal bg-brand-teal/15 shadow-[10px_10px_0_rgba(55,170,170,0.18)] transition-all duration-300 antigravity-hover reveal focus:outline-dashed focus:outline-2 focus:outline-offset-4 focus:outline-brand-yellow"
        >
          <div class="absolute inset-0 overflow-hidden bg-brand-teal/15">
            <img
              src={service.image}
              alt={service.title}
              loading="lazy"
              class="h-full w-full object-cover opacity-90 mix-blend-luminosity transition-all duration-500 group-hover:scale-105 group-hover:opacity-45 group-focus:scale-105 group-focus:opacity-45"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-teal/75 via-brand-teal/35 to-brand-teal/5"></div>
          </div>

          <div class="absolute inset-x-0 bottom-0 z-10 p-5 text-white transition-transform duration-300 group-hover:-translate-y-40 group-focus:-translate-y-40 sm:p-6">

            <h3 class="font-display max-w-[15rem] text-3xl leading-[0.92] tracking-[-0.04em] [text-shadow:0_8px_18px_rgba(18,63,61,0.45)] sm:text-4xl">
              {service.title}
            </h3>
          </div>

          <div class={`absolute inset-x-0 bottom-0 z-20 translate-y-full rounded-t-[1.75rem] ${service.descriptionBg} p-6 text-brand-ink shadow-2xl shadow-brand-ink/20 transition-transform duration-500 ease-out group-hover:translate-y-0 group-focus:translate-y-0`}>
            <p class="text-lg font-semibold leading-tight sm:text-xl">
              {service.description}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-20 reveal">
      <div class="text-center mb-10">
        <span class="section-kicker">
          Packs de ahorro
        </span>
        <h3 class="font-display text-3xl font-black tracking-[-0.04em] text-brand-ink sm:text-5xl">
          Ahorra con nuestros bonos mensuales
        </h3>
        <p class="mx-auto mt-5 max-w-3xl text-lg font-semibold leading-relaxed text-brand-ink/65">
          Bonos de peluquería canina y felina en Esplugues para mantener el baño, el cepillado y el cuidado básico de tu mascota al día con un precio más cómodo y adaptado a tu mascota.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {packs.map((pack) => (
          <article
            class={`pet-store-ticket group relative cursor-default overflow-hidden border-2 p-6 antigravity-hover reveal sm:p-8 ${pack.className}`}
          >
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.22),transparent_42%)]"></div>
            <div class="relative z-10 flex h-full flex-col sm:min-h-56">
              <div class="mb-6 flex items-start justify-between gap-4">
                <div class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl transition-transform duration-300 group-hover:rotate-[-6deg] group-hover:scale-110 ${pack.iconClassName}`}>
                  <span
                    aria-hidden="true"
                    class="h-7 w-7 bg-current"
                    style="mask: url('/images/paw-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/paw-solid-full.svg') center / contain no-repeat;"
                  ></span>
                </div>
                <span class={`rounded-full px-4 py-2 text-xs font-black uppercase tracking-[0.16em] ${pack.labelClassName}`}>
                  Pregunta en tienda
                </span>
              </div>
              <h3 class="mb-3 font-display text-3xl leading-none tracking-[-0.04em]">
                {pack.title}
              </h3>
              <p class={`text-sm font-medium leading-relaxed sm:text-base ${pack.textClassName}`}>
                {pack.description}
              </p>
              <div class="mt-auto flex h-10 items-center pt-6">
                <img
                  src="/images/cap_i_cua-h-logo.svg"
                  alt="Cap i Cua"
                  loading="lazy"
                  class={`h-9 w-[14.5rem] object-contain object-left ${pack.logoClassName}`}
                />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-12 text-center reveal">
      <div class="ticket-cut group flex w-full items-center gap-3 border-2 border-brand-pink bg-brand-pink/25 px-6 py-4 text-sm font-semibold text-[#B06267] backdrop-blur">
        <span
          aria-hidden="true"
          class="h-7 w-7 shrink-0 bg-[#B06267] transition-transform duration-300 ease-out group-hover:scale-125"
          style="mask: url('/images/bullhorn-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/bullhorn-solid-full.svg') center / contain no-repeat;"
        ></span>
        <span class="origin-left transition-transform duration-300 ease-out group-hover:scale-[1.03]"><strong>Importante:</strong> Precios a consultar según la raza, tamaño, el tipo de pelo y el estado del manto.</span>
      </div>
    </div>
  </div>
</section>

<script>
  const revealElements = document.querySelectorAll('.reveal');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  revealElements.forEach((el) => revealObserver.observe(el));
</script>

<style>
  .pet-store-ticket {
    border-radius: 1.75rem;
  }

  .bath-pack-mesh {
    background-color: hsla(180, 51%, 44%, 1);
    background-image:
      radial-gradient(at 89% 68%, hsla(180, 61%, 55%, 1) 0px, transparent 50%),
      radial-gradient(at 5% 46%, hsla(180, 49%, 35%, 1) 0px, transparent 50%),
      radial-gradient(at 72% 42%, hsla(180, 62%, 59%, 1) 0px, transparent 50%),
      radial-gradient(at 80% 6%, hsla(180, 51%, 44%, 1) 0px, transparent 50%),
      radial-gradient(at 87% 94%, hsla(180, 49%, 33%, 1) 0px, transparent 50%),
      radial-gradient(at 19% 94%, hsla(180, 54%, 31%, 1) 0px, transparent 50%);
  }
</style>
