          <ul class="flex w-full justify-center gap-5 md:w-auto md:justify-end">
            <li><a href="https://instagram.com/capicuapetstore" target="_blank" rel="noopener noreferrer" class="inline-flex text-brand-paper transition-all duration-300 hover:-translate-y-1 hover:scale-110 hover:text-brand-yellow" aria-label="Instagram"><span aria-hidden="true" class="h-9 w-9 bg-current" style="mask: url('/images/instagram-brands-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/instagram-brands-solid-full.svg') center / contain no-repeat;"></span></a></li>
            <li><a href="https://www.tiktok.com/@capicuapetstore" target="_blank" rel="noopener noreferrer" class="inline-flex text-brand-paper transition-all duration-300 hover:-translate-y-1 hover:scale-110 hover:text-brand-yellow" aria-label="TikTok"><svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82a4.7 4.7 0 0 1-1.16-3.08h-3.18v12.52a2.66 2.66 0 1 1-1.82-2.52V9.5a5.86 5.86 0 1 0 5 5.8V8.95a7.82 7.82 0 0 0 4.58 1.47V7.24a4.67 4.67 0 0 1-3.42-1.42Z" /></svg></a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="bg-[#1f110c]"><div class="mx-auto flex max-w-[76rem] flex-col gap-4 px-4 py-6 text-sm text-brand-paper/70 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"><p class="text-left">&copy; {new Date().getFullYear()} Cap i Cua Pet Store. {t.footer.rights}</p><div class="flex flex-wrap gap-4 text-left sm:justify-end sm:text-right"><a href={t.footer.legalHref} target="_blank" rel="noopener noreferrer" class="text-brand-paper transition-colors hover:text-brand-yellow">{t.footer.legal}</a><a href={t.footer.privacyHref} target="_blank" rel="noopener noreferrer" class="text-brand-paper transition-colors hover:text-brand-yellow">{t.footer.privacy}</a></div></div></div>
  </footer>

  <script>
    const nav = document.querySelector('[data-main-nav]');
    const hero = document.querySelector('#hero');
    const scrollUpButton = document.querySelector('[data-scroll-up]');
    const menuToggle = document.querySelector('[data-menu-toggle]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    const languageSwitch = document.querySelector('[data-language-switch]');

    const savedScrollY = window.sessionStorage.getItem('language-switch-scroll-y');
    if (savedScrollY) {
      window.sessionStorage.removeItem('language-switch-scroll-y');
      window.requestAnimationFrame(() => {
        window.scrollTo({ top: Number(savedScrollY), behavior: 'instant' });
      });
    }

    languageSwitch?.addEventListener('click', () => {
      window.sessionStorage.setItem('language-switch-scroll-y', String(window.scrollY));
    });

    if (menuToggle && mobileMenu) {
      const setMenuOpen = (isOpen) => {
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuToggle.setAttribute('aria-label', isOpen ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen);
        mobileMenu.hidden = false;
        mobileMenu.classList.toggle('pointer-events-none', !isOpen);
        mobileMenu.classList.toggle('scale-95', !isOpen);
        mobileMenu.classList.toggle('opacity-0', !isOpen);
        mobileMenu.classList.toggle('scale-100', isOpen);
        mobileMenu.classList.toggle('opacity-100', isOpen);
        if (!isOpen) {
          window.setTimeout(() => {
            if (menuToggle.getAttribute('aria-expanded') === 'false') mobileMenu.hidden = true;
          }, 200);
        }
      };
      menuToggle.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
      mobileMenu.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
      });
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });
      window.addEventListener('resize', () => {
        if (window.matchMedia('(min-width: 640px)').matches) setMenuOpen(false);
      });
    }

    if (nav && hero) {
      const updateNav = () => {
        const heroBottom = hero.getBoundingClientRect().bottom;
        const hasPassedHero = heroBottom <= nav.clientHeight;
        if (scrollUpButton) {
          scrollUpButton.classList.toggle('pointer-events-none', !hasPassedHero);
          scrollUpButton.classList.toggle('opacity-0', !hasPassedHero);
          scrollUpButton.classList.toggle('opacity-100', hasPassedHero);
        }
      };
      updateNav();
      window.addEventListener('scroll', updateNav, { passive: true });
      window.addEventListener('resize', updateNav);
    }
  </script>

  <style>
    [data-menu-line] { transform-box: fill-box; transform-origin: center; transition: transform 220ms ease, opacity 160ms ease; }
    [data-menu-toggle][aria-expanded='true'] [data-menu-line='top'] { transform: translateY(5px) rotate(45deg); }
    [data-menu-toggle][aria-expanded='true'] [data-menu-line='middle'] { opacity: 0; transform: scaleX(0.35); }
    [data-menu-toggle][aria-expanded='true'] [data-menu-line='bottom'] { transform: translateY(-5px) rotate(-45deg); }
    .mobile-menu-link::before, .mobile-menu-link::after { background: radial-gradient(transparent, rgba(255, 255, 255, 0.94)); }
    .mobile-menu-link:hover::before, .mobile-menu-link:hover::after { opacity: 0.96; }
  </style>
</Layout>
