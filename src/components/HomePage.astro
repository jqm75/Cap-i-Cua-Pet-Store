        </button>
        <div class="hidden items-center justify-center gap-2 sm:flex sm:w-auto">
          <a href="#servicios" class="nav-ripple-link shrink-0 whitespace-nowrap px-2.5 py-2 text-sm font-semibold text-brand-ink/80 transition-colors hover:text-brand-teal sm:px-4 sm:text-base rounded-full">{t.nav.services}</a>
