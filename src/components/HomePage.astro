type Locale = keyof typeof translations;
const locale = (Astro.props.locale === 'ca' ? 'ca' : 'es') as Locale;
const t = translations[locale];
const whatsappUrl = 'https://wa.me/34688956540';
---

<Layout title={t.title} description={t.description} lang={t.lang} ogLocale={t.ogLocale} alternateLanguages>
  <nav data-main-nav aria-label={t.navLabel} class="fixed top-0 left-0 right-0 z-50 border-b border-white/35 bg-brand-yellow shadow-[0_16px_40px_rgba(18,63,61,0.12)] backdrop-blur-none backdrop-saturate-100 transition-[background-color,border-color,box-shadow,backdrop-filter] duration-500 ease-out sm:bg-brand-yellow/55 sm:backdrop-blur-2xl sm:backdrop-saturate-150">
    <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative flex h-16 items-center justify-between gap-4">
        <div class="flex items-center gap-2 sm:gap-3">
          <a href={t.logoHref} class="flex items-center gap-2.5 group rounded-full px-3 py-1.5">
            <img src="/images/cap_i_cua-h-logo.svg" alt="Cap i Cua" class="h-8 sm:h-10 w-auto max-w-[8rem] sm:max-w-none group-hover:scale-105 transition-transform" />
          </a>
          <a href={t.switchHref} hreflang={locale === 'ca' ? 'es' : 'ca'} aria-label={t.switchLabel} data-language-switch class="group relative inline-grid h-10 grid-cols-2 items-center overflow-hidden rounded-full bg-white/70 p-1 text-[0.68rem] font-black uppercase tracking-[0.1em] text-brand-ink shadow-lg shadow-brand-teal/25 backdrop-blur transition-colors duration-300 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-teal sm:text-xs">
            <span aria-hidden="true" class={`absolute left-1 top-1 h-8 w-[calc(50%-0.25rem)] rounded-full bg-brand-teal shadow-[0_6px_14px_rgba(55,170,170,0.35)] transition-transform duration-300 ease-out ${locale === 'ca' ? 'translate-x-full' : 'translate-x-0'}`}></span>
            <span class={`relative z-10 flex h-8 min-w-9 items-center justify-center rounded-full px-2 transition-colors duration-300 ${locale === 'es' ? 'text-white' : 'text-brand-ink/55 group-hover:text-brand-ink'}`}>ES</span>
            <span class={`relative z-10 flex h-8 min-w-9 items-center justify-center rounded-full px-2 transition-colors duration-300 ${locale === 'ca' ? 'text-white' : 'text-brand-ink/55 group-hover:text-brand-ink'}`}>CA</span>
          </a>
        </div>
        <button type="button" data-menu-toggle aria-controls="mobile-menu" aria-expanded="false" aria-label={t.menuOpen} data-label-open={t.menuOpen} data-label-close={t.menuClose} class="inline-flex h-11 w-11 items-center justify-center text-brand-ink transition-colors hover:text-brand-teal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-teal sm:hidden">
