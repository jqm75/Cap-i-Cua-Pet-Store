---
const address = 'Carrer del Mestre Joan Corrales, 33, 08950 Esplugues de Llobregat, Barcelona, España';
const googleMapsUrl = 'https://maps.app.goo.gl/t8cf8Aht3t4PiMgS8';
---

<section id="ubicacion" class="relative py-20 sm:py-28 overflow-hidden bg-gradient-to-br from-brand-teal/5 via-white to-brand-yellow/5">
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-brand-teal/[0.04] rounded-full -translate-x-1/2 translate-y-1/2"></div>

  <div class="relative max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 reveal">
      <span class="inline-block px-4 py-1.5 mb-4 text-sm font-semibold text-brand-teal bg-brand-teal/10 rounded-full">
        Dónde estamos
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-brown">
        Visítanos en Esplugues
      </h2>
      <p class="mt-4 text-brand-brown/60 text-lg">
        Estamos encantados de recibirte en nuestra tienda.
      </p>
    </div>

    <div class="grid md:grid-cols-5 gap-8 items-start reveal">
      <!-- Address card -->
      <div class="md:col-span-2 bg-white rounded-2xl border border-brand-teal/10 p-6 sm:p-8 antigravity-hover">
        <div class="w-14 h-14 rounded-xl bg-brand-teal/10 flex items-center justify-center mb-5">
          <svg class="w-7 h-7 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-brand-brown mb-3">Dirección</h3>
        <p class="text-brand-brown/70 leading-relaxed mb-6">
          {address}
        </p>
        <div class="flex flex-col gap-3">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-brand-teal font-semibold hover:text-brand-teal/80 transition-colors duration-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            Abrir en Google Maps
          </a>
          <div class="flex items-center gap-3 text-sm text-brand-brown/50 border-t border-brand-brown/10 pt-4 mt-2">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              L-V 9:30-13:30 / 16:30-20:00
            </span>
          </div>
          <div class="flex items-center gap-1 text-sm text-brand-brown/50">
            <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Sáb 9:30-14:00
          </div>
        </div>
      </div>

      <!-- Map -->
      <div class="md:col-span-3 rounded-2xl overflow-hidden shadow-lg border border-brand-teal/10 antigravity-hover">
        <div class="relative w-full aspect-[4/3] bg-brand-teal/5">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2994.5!2d2.0858717!3d41.3736269!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4990d396ab5bf%3A0x386cb6d44496dbcb!2sCap%20i%20Cua!5e0!3m2!1ses!2ses"
            width="100%"
            height="100%"
            style="border:0; position: absolute; inset: 0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación de Cap i Cua Pet Store"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const revealElements = document.querySelectorAll('#ubicacion .reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );
  revealElements.forEach((el) => revealObserver.observe(el));
</script>
