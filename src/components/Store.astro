---
const whatsappUrl = 'https://wa.me/34688956540';

const categories = [
  {
    title: 'Alimentación',
    description: 'Piensos, comida húmeda y opciones adaptadas a cada etapa y necesidad.',
  },
  {
    title: 'Snacks y premios',
    description: 'Mordedores, premios y caprichos para educar, entretener y mimar.',
  },
  {
    title: 'Accesorios',
    description: 'Collares, correas, juguetes, camas y básicos para el día a día.',
  },
  {
    title: 'Cuidado e higiene',
    description: 'Productos para baño, cepillado, higiene y bienestar en casa.',
  },
];

const animals = ['Perros', 'Gatos', 'Conejos', 'Aves'];
---

<section id="tienda" class="store-mesh relative overflow-hidden py-20 text-brand-ink sm:py-28">
  <div class="absolute inset-x-0 top-0 z-10 -translate-y-px text-brand-paper" aria-hidden="true">
    <svg class="block h-14 w-full sm:h-20" viewBox="0 0 1440 120" preserveAspectRatio="none" fill="currentColor">
      <path d="M0 0h1440v55c-76 25-160 38-253 38-150 0-246-51-393-51-173 0-266 70-438 70C201 112 92 86 0 55V0Z" />
    </svg>
  </div>

  <div class="absolute inset-x-0 bottom-0 z-10 translate-y-px rotate-180 text-brand-paper" aria-hidden="true">
    <svg class="block h-14 w-full sm:h-20" viewBox="0 0 1440 120" preserveAspectRatio="none" fill="currentColor">
      <path d="M0 0h1440v55c-76 25-160 38-253 38-150 0-246-51-393-51-173 0-266 70-438 70C201 112 92 86 0 55V0Z" />
    </svg>
  </div>

  <div class="relative z-20 max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center reveal">
      <span class="section-kicker store-kicker">
        Tienda pet store
      </span>
      <h2 class="font-display text-4xl leading-none tracking-[-0.04em] text-brand-ink sm:text-6xl">
        También somos tienda para su día a día
      </h2>
      <p class="mt-5 text-lg font-semibold leading-relaxed text-brand-ink/65">
        Para ellos, en Cap i Cua encontrarás alimentación, snacks, accesorios y productos para cuidar a perros, gatos, conejos y aves en casa, con la misma cercanía que en la peluquería.
      </p>
      <div class="mt-8 aspect-[16/9] w-full overflow-hidden rounded-[2rem] border-2 border-brand-paper shadow-[10px_10px_0_rgba(18,63,61,0.16)]">
        <img
          src="/images/tienda.webp"
          alt="Interior de la tienda Cap i Cua con productos para mascotas"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-110"
        />
      </div>
    </div>

    <div class="mb-10 flex flex-wrap justify-center gap-3 reveal">
      {animals.map((animal) => (
        <span class="rounded-full border border-white/45 bg-white/60 px-4 py-2 text-sm font-black uppercase tracking-[0.12em] text-brand-ink shadow-[4px_4px_0_rgba(18,63,61,0.12)] backdrop-blur">
          {animal}
        </span>
      ))}
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((category) => (
        <div class="reveal border-t-2 border-brand-paper pt-5">
          <h3 class="mb-3 text-2xl font-black tracking-[-0.03em] text-brand-ink">
            {category.title}
          </h3>
          <p class="font-semibold leading-relaxed text-brand-ink/65">
            {category.description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center reveal">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="button-fill inline-flex items-center justify-center gap-3 rounded-full bg-brand-teal px-8 py-4 text-lg font-semibold text-white shadow-2xl shadow-brand-teal/30 transition-all duration-300 [--button-fill:#f8a780] hover:-translate-y-1 hover:text-brand-ink"
      >
        <span
          aria-hidden="true"
          class="h-5 w-5 bg-current"
          style="mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat;"
        ></span>
        <span>Pregúntanos por WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<style>
  .store-mesh {
    background-color: #99b8df;
    background-image:
      radial-gradient(at 18% 22%, rgba(55, 170, 170, 0.95) 0px, transparent 48%),
      radial-gradient(at 82% 18%, rgba(153, 184, 223, 0.95) 0px, transparent 44%),
      radial-gradient(at 14% 82%, rgba(153, 184, 223, 0.9) 0px, transparent 50%),
      radial-gradient(at 86% 76%, rgba(55, 170, 170, 0.82) 0px, transparent 48%),
      radial-gradient(at 50% 50%, rgba(243, 239, 237, 0.34) 0px, transparent 56%);
  }

  .store-kicker {
    color: #f3efed;
  }

  .store-kicker::before,
  .store-kicker::after {
    background: #f3efed;
  }
</style>

<script>
  const storeRevealElements = document.querySelectorAll('#tienda .reveal');
  const storeRevealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  storeRevealElements.forEach((el) => storeRevealObserver.observe(el));
</script>
