---
const whatsappUrl = 'https://wa.me/34688956540';
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-white via-[#f0fafb] to-[#e6f5f5]">
  <!-- Floating decorative elements (Antigravity effect) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-[15%] left-[8%] w-20 h-20 rounded-full bg-brand-yellow/20 animate-float"></div>
    <div class="absolute top-[25%] right-[15%] w-14 h-14 rounded-full bg-brand-teal/15 animate-float-delayed"></div>
    <div class="absolute bottom-[20%] left-[12%] w-10 h-10 rounded-full bg-brand-yellow/25 animate-float-slow"></div>
    <div class="absolute bottom-[30%] right-[10%] w-24 h-24 rounded-full bg-brand-teal/10 animate-float"></div>
    <div class="absolute top-[40%] left-[5%] w-6 h-6 rounded-full bg-brand-brown/10 animate-float-delayed"></div>
    <div class="absolute top-[60%] right-[5%] w-16 h-16 rounded-full bg-brand-yellow/15 animate-float-slow"></div>
    <div class="absolute top-[10%] left-[50%] w-8 h-8 rounded-full bg-brand-teal/20 animate-float-delayed"></div>
    <div class="absolute bottom-[10%] right-[25%] w-12 h-12 rounded-full bg-brand-yellow/10 animate-float"></div>

    <!-- Decorative paw prints floating -->
    <svg class="absolute top-[18%] right-[20%] w-12 h-12 text-brand-yellow/20 animate-float-delayed" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 7c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm-4 4c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm8 0c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm-4 4c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"/>
    </svg>
    <svg class="absolute bottom-[15%] left-[20%] w-10 h-10 text-brand-teal/15 animate-float-slow" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 7c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm-4 4c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm8 0c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm-4 4c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"/>
    </svg>
  </div>

  <div class="relative z-10 max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Text Content -->
      <div class="animate-fade-in-up">
        <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold text-brand-brown bg-brand-yellow/80 rounded-full">
          🐾 Peluquería canina &amp; felina
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight text-brand-brown">
          El mejor <span class="text-brand-teal">cuidado</span> para tu mejor amigo
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-brand-brown/70 leading-relaxed max-w-lg">
          En <strong class="text-brand-brown">Cap i Cua Pet Store</strong> tratamos a tu mascota como si fuera nuestra. 
          Peluquería, baño, corte de uñas y tratamientos con cariño y profesionalidad en Esplugues de Llobregat.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-brand-yellow text-brand-brown font-bold text-lg rounded-xl shadow-lg shadow-brand-yellow/30 hover:shadow-xl hover:shadow-brand-yellow/40 transition-all duration-300 hover:-translate-y-1"
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.523 3.656 1.423 5.157L2 22l5.006-1.389A9.956 9.956 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.62 0-3.12-.506-4.347-1.363l-.311-.196-2.97.824.796-2.896-.204-.324A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
            </svg>
            <span>Reserva por WhatsApp</span>
          </a>
          <a
            href="#servicios"
            class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-brand-brown font-semibold text-lg rounded-xl border-2 border-brand-teal/30 hover:border-brand-teal transition-all duration-300 hover:-translate-y-1"
          >
            Ver servicios
            <svg class="w-5 h-5 transition-transform group-hover:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
          </a>
        </div>
        <div class="mt-8 flex items-center gap-6 text-sm text-brand-brown/60">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Profesionales certificados
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Productos hipoalergénicos
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Trato personalizado
          </span>
        </div>
      </div>

      <!-- Right: Visual Composition with Antigravity -->
      <div class="relative flex items-center justify-center animate-fade-in" style="animation-delay: 0.3s;">
        <div class="relative w-full max-w-md aspect-square">
          <!-- Background circle -->
          <div class="absolute inset-4 rounded-full bg-brand-teal/10 animate-float"></div>
          <div class="absolute inset-8 rounded-full bg-brand-yellow/10 animate-float-delayed"></div>

          <!-- Center composition: pet illustration area -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="relative animate-float" style="animation-duration: 7s;">
              <!-- Dog silhouette as main graphic -->
              <svg class="w-48 h-48 sm:w-56 sm:h-56 text-brand-brown drop-shadow-xl" viewBox="0 0 100 100" fill="currentColor">
                <!-- Simplified cute dog face -->
                <ellipse cx="50" cy="55" rx="35" ry="30" fill="#512c1e"/>
                <ellipse cx="50" cy="50" rx="32" ry="27" fill="#7a4a32"/>
                <!-- ears -->
                <ellipse cx="22" cy="30" rx="12" ry="18" fill="#512c1e" transform="rotate(-15 22 30)"/>
                <ellipse cx="78" cy="30" rx="12" ry="18" fill="#512c1e" transform="rotate(15 78 30)"/>
                <!-- eyes -->
                <circle cx="40" cy="46" r="5" fill="white"/>
                <circle cx="60" cy="46" r="5" fill="white"/>
                <circle cx="41" cy="46" r="3" fill="#512c1e"/>
                <circle cx="61" cy="46" r="3" fill="#512c1e"/>
                <!-- nose -->
                <ellipse cx="50" cy="56" rx="5" ry="3.5" fill="#512c1e"/>
                <!-- tongue -->
                <ellipse cx="50" cy="64" rx="4" ry="5" fill="#f09b9b"/>
                <!-- collar -->
                <rect x="35" y="70" width="30" height="6" rx="3" fill="#37aaaa"/>
                <!-- tag -->
                <circle cx="50" cy="79" r="4" fill="#fecb2b"/>
              </svg>
            </div>
          </div>

          <!-- Floating elements around the dog -->
          <div class="absolute top-4 right-4 w-16 h-16 rounded-2xl bg-brand-yellow/90 flex items-center justify-center shadow-lg animate-float-delayed text-sm font-bold text-brand-brown">
            🐾<br/>+5 años
          </div>
          <div class="absolute bottom-8 left-2 w-14 h-14 rounded-xl bg-brand-teal/90 flex items-center justify-center shadow-lg animate-float-slow text-xs font-bold text-white">
            ★ 4.9
          </div>
          <div class="absolute top-1/3 -left-4 w-10 h-10 rounded-lg bg-white shadow-md flex items-center justify-center animate-float text-brand-teal font-bold text-xs">
            ✂️
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-brand-brown/40 animate-float">
    <span class="text-xs font-medium tracking-widest uppercase">Descubre más</span>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7"/>
    </svg>
  </div>
</section>
