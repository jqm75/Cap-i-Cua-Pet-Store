---
const whatsappUrl = 'https://wa.me/34688956540';
---

<section class="hero-noise relative min-h-screen overflow-hidden rounded-b-[2.5rem] bg-brand-yellow text-brand-ink sm:rounded-b-[4rem]">
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute right-[-14rem] top-[-8rem] h-[38rem] w-[38rem] rounded-full border border-brand-teal/40"></div>
    <div class="absolute right-[-7rem] top-[4rem] h-[24rem] w-[24rem] rounded-full border border-white/55"></div>
    <p class="font-display absolute left-1/2 top-24 -translate-x-1/2 whitespace-nowrap text-[17vw] uppercase leading-none tracking-[-0.08em] text-white/20">
      CAP I CUA
    </p>
  </div>

  <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-[76rem] flex-col justify-center px-4 pb-20 pt-28 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="animate-fade-in-up">
        <div class="mb-8 inline-flex items-center gap-3 rounded-full border border-brand-teal/30 bg-white/25 px-4 py-2 text-xs font-black uppercase tracking-[0.24em]">
          <span class="h-2 w-2 rounded-full bg-brand-teal shadow-[0_0_18px_rgba(55,170,170,0.9)]"></span>
          Peluquería canina &amp; felina
        </div>

        <h1 class="font-display max-w-5xl text-[clamp(3.2rem,9.4vw,8.1rem)] uppercase leading-[0.9] tracking-[-0.045em]">
          El cuidado<br />
          de tu mascota<br />
          <span class="inline-block text-white drop-shadow-[0_10px_0_rgba(55,170,170,0.45)]">empieza aquí</span>
        </h1>

        <p class="mt-8 max-w-xl text-lg font-semibold leading-relaxed text-brand-ink/70 sm:text-xl">
          En Cap i Cua cuidamos de tu perro o gato con servicios de grooming, alimentación, accesorios y trato cercano de tienda de barrio. En Esplugues de Llobregat, con cariño y profesionalidad.
        </p>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 rounded-full bg-brand-teal px-8 py-4 text-lg font-black text-white shadow-2xl shadow-brand-teal/30 transition-all duration-300 hover:-translate-y-1 hover:bg-brand-teal/90"
          >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.523 3.656 1.423 5.157L2 22l5.006-1.389A9.956 9.956 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.62 0-3.12-.506-4.347-1.363l-.311-.196-2.97.824.796-2.896-.204-.324A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
            </svg>
            Reserva por WhatsApp
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center rounded-full border-2 border-brand-teal/55 bg-white/30 px-8 py-4 text-lg font-black text-brand-teal transition-all duration-300 hover:-translate-y-1 hover:border-brand-teal hover:bg-white/55"
          >
            Ver servicios
          </a>
        </div>


      </div>

      <div class="relative mx-auto flex min-h-[31rem] w-full max-w-[34rem] items-center justify-center py-8 animate-fade-in" style="animation-delay: 0.25s;">
        <div class="absolute h-[33rem] w-[33rem] rounded-full border border-brand-teal/35"></div>
        <div class="absolute h-[26rem] w-[26rem] rounded-full border border-white/65"></div>
        <div class="absolute h-[19rem] w-[19rem] rounded-full border border-brand-ink/15"></div>
        <div class="absolute h-[25rem] w-[25rem] rotate-12 rounded-full border border-dashed border-brand-teal/55"></div>

        <div class="relative flex h-72 w-72 items-center justify-center rounded-full border border-white/70 bg-white/30 shadow-2xl shadow-brand-teal/25 sm:h-96 sm:w-96">
          <svg class="h-52 w-52 drop-shadow-2xl sm:h-64 sm:w-64" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <ellipse cx="50" cy="55" rx="35" ry="30" fill="#123f3d"/>
            <ellipse cx="50" cy="50" rx="32" ry="27" fill="#37aaaa"/>
            <ellipse cx="22" cy="30" rx="12" ry="18" fill="#123f3d" transform="rotate(-15 22 30)"/>
            <ellipse cx="78" cy="30" rx="12" ry="18" fill="#123f3d" transform="rotate(15 78 30)"/>
            <circle cx="40" cy="46" r="5" fill="white"/>
            <circle cx="60" cy="46" r="5" fill="white"/>
            <circle cx="41" cy="46" r="3" fill="#123f3d"/>
            <circle cx="61" cy="46" r="3" fill="#123f3d"/>
            <ellipse cx="50" cy="56" rx="5" ry="3.5" fill="#123f3d"/>
            <ellipse cx="50" cy="64" rx="4" ry="5" fill="#f09b9b"/>
            <rect x="35" y="70" width="30" height="6" rx="3" fill="#37aaaa"/>
            <circle cx="50" cy="79" r="4" fill="#fecb2b"/>
          </svg>
        </div>

        <img src="/images/paw-solid-full.svg" alt="" class="absolute -left-2 top-16 h-20 w-20 rotate-[-18deg] opacity-80 drop-shadow-xl animate-float sm:-left-10 sm:h-28 sm:w-28" />
        <img src="/images/paw-solid-full.svg" alt="" class="absolute -right-2 bottom-20 h-16 w-16 rotate-[16deg] opacity-70 drop-shadow-xl animate-float-delayed sm:-right-8 sm:h-24 sm:w-24" />
        <img src="/images/paw-solid-full.svg" alt="" class="absolute right-10 top-8 h-12 w-12 rotate-[28deg] opacity-60 drop-shadow-lg animate-float-slow sm:h-16 sm:w-16" />
      </div>
    </div>

    <div class="mt-20 grid gap-3 border-t border-brand-teal/25 pt-5 text-xs font-black uppercase tracking-[0.22em] text-brand-ink/55 sm:grid-cols-3">

    </div>
  </div>

  <a href="#servicios" class="absolute bottom-6 left-1/2 z-20 -translate-x-1/2 rounded-full px-4 py-2 text-center text-xs font-black uppercase tracking-[0.35em] text-brand-ink/55 transition-colors hover:text-brand-teal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-teal">
    <span class="block animate-float">
      Descubre más
      <svg class="mx-auto mt-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7"/>
      </svg>
    </span>
  </a>
</section>
