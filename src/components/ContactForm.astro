---
const mailtoUrl = 'mailto:hola@capicuapetstore.com';
---

<section id="contact-form" class="relative py-20 sm:py-28 overflow-hidden bg-white">
  <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 reveal">
      <span class="inline-block px-4 py-1.5 mb-4 text-sm font-semibold text-brand-yellow bg-brand-yellow/15 rounded-full">
        Escríbenos
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-brown">
        ¿Tienes alguna pregunta?
      </h2>
      <p class="mt-4 text-brand-brown/60 text-lg">
        Cuéntanos cómo podemos ayudarte y te responderemos a la mayor brevedad.
      </p>
    </div>

    <form
      action={mailtoUrl}
      method="POST"
      enctype="text/plain"
      class="reveal space-y-6 bg-brand-teal/[0.03] border border-brand-teal/10 rounded-2xl p-8 sm:p-10"
    >
      <div>
        <label for="name" class="block text-sm font-semibold text-brand-brown mb-2">Nombre</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Tu nombre"
          class="w-full px-5 py-3.5 rounded-xl border-2 border-brand-brown/15 bg-white text-brand-brown placeholder-brand-brown/40 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/20 outline-none transition-all duration-300"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-brand-brown mb-2">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="tu@email.com"
          class="w-full px-5 py-3.5 rounded-xl border-2 border-brand-brown/15 bg-white text-brand-brown placeholder-brand-brown/40 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/20 outline-none transition-all duration-300"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-brand-brown mb-2">Mensaje</label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder="Cuéntanos qué necesitas..."
          class="w-full px-5 py-3.5 rounded-xl border-2 border-brand-brown/15 bg-white text-brand-brown placeholder-brand-brown/40 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/20 outline-none transition-all duration-300 resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 bg-brand-yellow text-brand-brown font-bold text-lg rounded-xl shadow-lg shadow-brand-yellow/30 hover:shadow-xl hover:shadow-brand-yellow/40 transition-all duration-300 hover:-translate-y-1"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Enviar mensaje
      </button>
    </form>
  </div>
</section>

<script>
  const revealElements = document.querySelectorAll('#contact-form .reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );
  revealElements.forEach((el) => revealObserver.observe(el));
</script>
