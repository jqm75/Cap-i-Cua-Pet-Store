---
const whatsappUrl = 'https://wa.me/34688956540';
const instagramUrl = 'https://instagram.com/capicuapetstore';
const mailtoUrl = 'mailto:hola@capicuapetstore.com';
---

<section id="contacto" class="relative overflow-hidden bg-brand-yellow py-20 sm:py-32">
  <div class="absolute left-[-10rem] top-12 h-80 w-80 rounded-full bg-brand-teal/25 blur-3xl"></div>
  <div class="absolute bottom-[-8rem] right-[-10rem] h-96 w-96 rounded-full bg-white/25 blur-3xl"></div>

  <div class="container relative mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid overflow-hidden rounded-[2.5rem] bg-brand-brown text-white shadow-2xl shadow-brand-ink/25 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:rounded-[4rem] reveal">
      <div class="p-8 sm:p-12 md:p-16 lg:p-20">
        <span class="mb-5 inline-flex rounded-full bg-brand-teal px-4 py-1.5 text-xs font-black uppercase tracking-[0.22em] text-white">
          Contacto
        </span>
        <h2 class="font-display mb-10 text-5xl leading-none text-brand-yellow sm:text-6xl">
          Contacta
        </h2>

        <div class="mb-14 space-y-8">
          <div class="flex items-center gap-5 sm:gap-6">
            <img src="/images/location-dot-solid-full.svg" class="h-7 w-7 shrink-0 brightness-0 invert transition-all hover:brightness-100 hover:invert-0" alt="" />
            <p class="text-sm font-black uppercase tracking-tight text-white/75">
              Mestre Joan Corrales, 33, Esplugues de Llobregat
            </p>
          </div>

          <div class="group flex items-center gap-5 sm:gap-6">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
              <img src="/images/whatsapp-brands-solid-full.svg" class="h-7 w-7 shrink-0 brightness-0 invert transition-all group-hover:brightness-100 group-hover:invert-0" alt="" />
            </a>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-xl font-black tracking-widest text-brand-yellow transition-colors hover:text-brand-teal">
              +34 688 956 540
            </a>
          </div>

          <div class="group flex items-center gap-5 sm:gap-6">
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <img src="/images/instagram-brands-solid-full.svg" class="h-7 w-7 shrink-0 brightness-0 invert transition-all group-hover:brightness-100 group-hover:invert-0" alt="" />
            </a>
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="font-black text-white/50 transition-opacity hover:text-brand-teal hover:opacity-100">
              @capicuapetstore
            </a>
          </div>
        </div>

        <form action={mailtoUrl} method="POST" enctype="text/plain" class="space-y-4">
          <input
            type="text"
            name="pet"
            placeholder="Tu mascota"
            class="w-full rounded-3xl border border-white/10 bg-white/5 p-5 text-white outline-none transition-all placeholder:text-white/40 focus:bg-white focus:text-brand-ink focus:placeholder:text-brand-ink/40"
          />
          <textarea
            name="message"
            placeholder="¿Alguna consulta?"
            class="h-32 w-full resize-none rounded-3xl border border-white/10 bg-white/5 p-5 text-white outline-none transition-all placeholder:text-white/40 focus:bg-white focus:text-brand-ink focus:placeholder:text-brand-ink/40"
          ></textarea>
          <button type="submit" class="w-full rounded-3xl bg-brand-teal py-6 font-black uppercase tracking-widest text-white shadow-xl shadow-black/20 transition-all hover:bg-brand-yellow hover:text-brand-ink">
            Enviar
          </button>
        </form>
      </div>

      <div class="relative min-h-[620px] overflow-hidden bg-white/10 md:min-h-[680px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2994.5!2d2.0858717!3d41.3736269!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4990d396ab5bf%3A0x386cb6d44496dbcb!2sCap%20i%20Cua!5e0!3m2!1ses!2ses"
          width="100%"
          height="100%"
          style="border:0; position: absolute; inset: 0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Cap i Cua Pet Store"
          class="grayscale opacity-70 transition-all duration-1000 hover:grayscale-0 hover:opacity-100"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const revealElements = document.querySelectorAll('#contacto .reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );
  revealElements.forEach((el) => revealObserver.observe(el));
</script>
