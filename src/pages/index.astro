---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Store from '../components/Store.astro';
import Follow from '../components/Follow.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Cap i Cua Pet Store – Peluquería canina y felina en Esplugues"
  description="Peluquería canina y felina en Esplugues de Llobregat. Baño, corte profesional, uñas y tratamientos para tu mascota. ¡Reserva tu cita por WhatsApp!"
>
  <!-- Navigation Bar -->
  <nav data-main-nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/35 bg-brand-yellow/55 shadow-[0_16px_40px_rgba(18,63,61,0.12)] backdrop-blur-2xl backdrop-saturate-150 transition-[background-color,border-color,box-shadow,backdrop-filter] duration-500 ease-out">
    <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2.5 group rounded-full px-3 py-1.5">
          <img src="/images/cap_i_cua-h-logo.svg" alt="Cap i Cua" class="h-8 sm:h-10 w-auto max-w-[8rem] sm:max-w-none group-hover:scale-105 transition-transform" />
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <a href="#servicios" class="nav-ripple-link px-3 sm:px-4 py-2 text-base font-semibold text-brand-ink/80 hover:text-brand-teal rounded-full transition-colors">Servicios</a>
          <a href="#tienda" class="nav-ripple-link hidden px-3 py-2 text-base font-semibold text-brand-ink/80 transition-colors hover:text-brand-teal sm:inline-flex sm:px-4 rounded-full">Tienda</a>
          <a href="#contacto" class="nav-ripple-link px-3 sm:px-4 py-2 text-base font-semibold text-brand-ink/80 hover:text-brand-teal rounded-full transition-colors">Contacto</a>
          <a
            href="https://wa.me/34688956540"
            target="_blank"
            rel="noopener noreferrer"
            class="button-fill group ml-2 inline-flex items-center gap-2 px-4 py-2 bg-brand-teal text-white font-semibold text-base rounded-full shadow-lg shadow-brand-teal/25 transition-all hover:-translate-y-0.5 hover:text-brand-yellow"
          >
            <span
              aria-hidden="true"
              class="h-5 w-5 bg-current"
              style="mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat;"
            ></span>
            <span>Escríbenos</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main class="bg-brand-paper">
    <Hero />
    <Services />
    <Store />
    <Follow />
    <ContactForm />
  </main>

  <a
    href="#hero"
    data-scroll-up
    aria-label="Volver arriba"
    class="pointer-events-none fixed bottom-5 right-5 z-50 inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-brand-brown bg-brand-teal text-white opacity-0 shadow-[6px_6px_0_rgba(81,44,30,0.24)] transition-all duration-500 ease-out hover:-translate-y-1 hover:bg-brand-yellow hover:text-brand-brown focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-yellow sm:bottom-7 sm:right-7 sm:h-14 sm:w-14"
  >
    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
    </svg>
  </a>

  <!-- Footer -->
  <footer class="bg-brand-brown text-white/80">
    <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="grid sm:grid-cols-3 gap-8 text-center sm:text-left">
        <div>
          <img src="/images/capicuapetstore-logo-footer.svg" alt="Cap i Cua" class="h-20 w-auto brightness-0 invert" />
          <p class="mt-2 text-sm text-white/60">Cuidado y estética para tu mascota en Esplugues de Llobregat.</p>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-3">Enlaces</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#servicios" class="text-brand-teal hover:text-white transition-colors">Servicios</a></li>
            <li><a href="#tienda" class="text-brand-teal hover:text-white transition-colors">Tienda</a></li>
            <li><a href="#contacto" class="text-brand-teal hover:text-white transition-colors">Contacto</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-3">Contacto</h4>
          <ul class="space-y-3 text-sm">
            <li>
              <a href="https://wa.me/34688956540" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-brand-teal hover:text-white transition-colors">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
                </svg>
                +34 688 95 65 40
              </a>
            </li>
            <li>
              <a href="https://instagram.com/capicuapetstore" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-brand-teal hover:text-white transition-colors">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 9a3.75 3.75 0 1 0 0 7.5A3.75 3.75 0 0 0 12 9Z" />
                  <path fill-rule="evenodd" d="M9.344 3.071a49.52 49.52 0 0 1 5.312 0c.967.052 1.83.585 2.332 1.39l.821 1.317c.24.383.645.643 1.11.71.386.054.77.113 1.152.177 1.432.239 2.429 1.493 2.429 2.909V18a3 3 0 0 1-3 3h-15a3 3 0 0 1-3-3V9.574c0-1.416.997-2.67 2.429-2.909.382-.064.766-.123 1.151-.178a1.56 1.56 0 0 0 1.11-.71l.822-1.315a2.942 2.942 0 0 1 2.332-1.39ZM6.75 12.75a5.25 5.25 0 1 1 10.5 0 5.25 5.25 0 0 1-10.5 0Zm12-1.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
                </svg>
                @capicuapetstore
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-white/40 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-left">
          &copy; {new Date().getFullYear()} Cap i Cua Pet Store. Todos los derechos reservados.
        </p>
        <div class="flex flex-wrap gap-4 text-left sm:justify-end sm:text-right">
          <a href="/aviso-legal" class="text-brand-teal transition-colors hover:text-white">Aviso Legal</a>
          <a href="/politica-privacidad" class="text-brand-teal transition-colors hover:text-white">Política de privacidad</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const nav = document.querySelector('[data-main-nav]');
    const hero = document.querySelector('#hero');
    const scrollUpButton = document.querySelector('[data-scroll-up]');

    if (nav && hero) {
      const updateNav = () => {
        const heroBottom = hero.getBoundingClientRect().bottom;
        const hasPassedHero = heroBottom <= nav.clientHeight;

        if (scrollUpButton) {
          scrollUpButton.classList.toggle('pointer-events-none', !hasPassedHero);
          scrollUpButton.classList.toggle('opacity-0', !hasPassedHero);
          scrollUpButton.classList.toggle('opacity-100', hasPassedHero);
        }
      };

      updateNav();
      window.addEventListener('scroll', updateNav, { passive: true });
      window.addEventListener('resize', updateNav);
    }
  </script>
</Layout>
