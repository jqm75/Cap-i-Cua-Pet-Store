---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Store from '../components/Store.astro';
import Follow from '../components/Follow.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Cap i Cua Pet Store – Peluquería canina y felina en Esplugues"
  description="Peluquería canina y felina en Esplugues de Llobregat. Baño, corte profesional, uñas y tratamientos para tu mascota. ¡Reserva tu cita por WhatsApp!"
>
  <!-- Navigation Bar -->
  <nav data-main-nav aria-label="Navegación principal" class="fixed top-0 left-0 right-0 z-50 border-b border-white/35 bg-brand-yellow shadow-[0_16px_40px_rgba(18,63,61,0.12)] backdrop-blur-none backdrop-saturate-100 transition-[background-color,border-color,box-shadow,backdrop-filter] duration-500 ease-out sm:bg-brand-yellow/55 sm:backdrop-blur-2xl sm:backdrop-saturate-150">
    <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 group rounded-full px-3 py-1.5">
          <img src="/images/cap_i_cua-h-logo.svg" alt="Cap i Cua" class="h-8 sm:h-10 w-auto max-w-[8rem] sm:max-w-none group-hover:scale-105 transition-transform" />
        </a>
        <button
          type="button"
          data-menu-toggle
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú"
          class="inline-flex h-11 w-11 items-center justify-center text-brand-ink transition-colors hover:text-brand-teal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-teal sm:hidden"
        >
          <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path data-menu-line="top" stroke-linecap="round" stroke-width="2.5" d="M4 7h16" />
            <path data-menu-line="middle" stroke-linecap="round" stroke-width="2.5" d="M4 12h16" />
            <path data-menu-line="bottom" stroke-linecap="round" stroke-width="2.5" d="M4 17h16" />
          </svg>
        </button>
        <div class="hidden items-center justify-center gap-2 sm:flex sm:w-auto">
          <a href="#servicios" class="nav-ripple-link shrink-0 whitespace-nowrap px-2.5 py-2 text-sm font-semibold text-brand-ink/80 transition-colors hover:text-brand-teal sm:px-4 sm:text-base rounded-full">Servicios</a>
          <a href="#tienda" class="nav-ripple-link px-3 py-2 text-base font-semibold text-brand-ink/80 transition-colors hover:text-brand-teal sm:inline-flex sm:px-4 rounded-full">Tienda</a>
          <a href="#contacto" class="nav-ripple-link shrink-0 whitespace-nowrap px-2.5 py-2 text-sm font-semibold text-brand-ink/80 transition-colors hover:text-brand-teal sm:px-4 sm:text-base rounded-full">Contacto</a>
          <a
            href="https://wa.me/34688956540"
            target="_blank"
            rel="noopener noreferrer"
            class="button-fill group ml-1 inline-flex shrink-0 items-center gap-1.5 rounded-full bg-brand-teal px-3 py-2 text-sm font-semibold text-white shadow-lg shadow-brand-teal/25 transition-all hover:text-brand-yellow sm:ml-2 sm:gap-2 sm:px-4 sm:text-base"
          >
            <span
              aria-hidden="true"
              class="h-4 w-4 bg-current sm:h-5 sm:w-5"
              style="mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat;"
            ></span>
            <span>Escríbenos</span>
          </a>
        </div>
        <div
          id="mobile-menu"
          data-mobile-menu
          class="pointer-events-none absolute left-0 right-0 top-full mt-2 origin-top scale-95 rounded-[1.75rem] border-2 border-white/60 bg-brand-paper/95 p-3 text-brand-ink opacity-0 shadow-[8px_8px_0_rgba(81,44,30,0.18)] backdrop-blur-xl transition-all duration-200 ease-out sm:hidden"
          hidden
        >
          <div class="grid gap-1">
            <a href="#servicios" class="nav-ripple-link mobile-menu-link rounded-full px-4 py-3 text-base font-semibold text-brand-ink transition-colors hover:text-brand-teal">Servicios</a>
            <a href="#tienda" class="nav-ripple-link mobile-menu-link rounded-full px-4 py-3 text-base font-semibold text-brand-ink transition-colors hover:text-brand-teal">Tienda</a>
            <a href="#contacto" class="nav-ripple-link mobile-menu-link rounded-full px-4 py-3 text-base font-semibold text-brand-ink transition-colors hover:text-brand-teal">Contacto</a>
            <a
              href="https://wa.me/34688956540"
              target="_blank"
              rel="noopener noreferrer"
              class="button-fill mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-brand-teal px-5 py-3 text-base font-semibold text-white shadow-lg shadow-brand-teal/25 transition-all hover:text-brand-yellow"
            >
              <span
                aria-hidden="true"
                class="h-6 w-6 bg-current"
                style="mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/whatsapp-brands-solid-full.svg') center / contain no-repeat;"
              ></span>
              <span>Escríbenos</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main class="bg-brand-paper">
    <Hero />
    <Services />
    <Store />
    <Follow />
    <ContactForm />
  </main>

  <a
    href="#hero"
    data-scroll-up
    aria-label="Volver arriba"
    class="pointer-events-none fixed bottom-5 right-5 z-50 inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand-teal text-white opacity-0 shadow-[6px_6px_0_rgba(81,44,30,0.24)] transition-all duration-500 ease-out hover:-translate-y-1 hover:bg-brand-yellow hover:text-brand-brown focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-yellow sm:bottom-7 sm:right-7 sm:h-14 sm:w-14"
  >
    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
    </svg>
  </a>

  <!-- Footer -->
  <footer class="bg-[#321b13] text-brand-paper">
    <div class="max-w-[76rem] mx-auto px-4 py-14 sm:px-6 lg:px-8">
      <div class="grid gap-10 text-center md:grid-cols-[1.25fr_1fr_1fr] md:items-start md:text-left lg:gap-16">
        <div class="mx-auto max-w-xs md:mx-0 md:justify-self-start">
          <img src="/images/capicuapetstore-logo-footer.svg" alt="Cap i Cua" class="mx-auto h-20 w-auto brightness-0 invert md:mx-0" />
          <p class="mt-3 text-sm leading-relaxed text-brand-paper/70">Cuidado y estética para tu mascota en Esplugues de Llobregat.</p>
        </div>
        <div class="mx-auto md:mx-0 md:justify-self-center">
          <h4 class="mb-4 font-semibold text-brand-paper">Contacto</h4>
          <ul class="space-y-3 text-sm">
            <li>
              <a href="tel:+34688956540" class="inline-flex items-center justify-center gap-2 text-brand-paper transition-colors hover:text-brand-yellow md:justify-start">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
                </svg>
                +34 688 95 65 40
              </a>
            </li>
            <li>
              <a href="mailto:hola@capicuapetstore.com" class="inline-flex items-center justify-center gap-2 text-brand-paper transition-colors hover:text-brand-yellow md:justify-start">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0l-7.5-4.615a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
                hola@capicuapetstore.com
              </a>
            </li>
            <li>
              <a href="https://www.google.com/maps/place/?q=Cap+i+Cua+Pet+Store+Esplugues" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 text-brand-paper transition-colors hover:text-brand-yellow md:justify-start">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s6-5.33 6-11a6 6 0 1 0-12 0c0 5.67 6 11 6 11Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" />
                </svg>
                Mestre Joan Corrales, 33, local. 08950 Esplugues de Llobregat, Barcelona
              </a>
            </li>
          </ul>
        </div>
        <div class="mx-auto flex flex-col items-center md:mx-0 md:items-end md:justify-self-end md:text-right">
          <h4 class="mb-4 font-semibold text-brand-paper">Síguenos</h4>
          <ul class="flex w-full justify-center gap-5 md:w-auto md:justify-end">
            <li>
              <a href="https://instagram.com/capicuapetstore" target="_blank" rel="noopener noreferrer" class="inline-flex text-brand-paper transition-all duration-300 hover:-translate-y-1 hover:scale-110 hover:text-brand-yellow" aria-label="Instagram">
                <span
                  aria-hidden="true"
                  class="h-9 w-9 bg-current"
                  style="mask: url('/images/instagram-brands-solid-full.svg') center / contain no-repeat; -webkit-mask: url('/images/instagram-brands-solid-full.svg') center / contain no-repeat;"
                ></span>
              </a>
            </li>
            <li>
              <a href="https://www.tiktok.com/@capicuapetstore" target="_blank" rel="noopener noreferrer" class="inline-flex text-brand-paper transition-all duration-300 hover:-translate-y-1 hover:scale-110 hover:text-brand-yellow" aria-label="TikTok">
                <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M16.6 5.82a4.7 4.7 0 0 1-1.16-3.08h-3.18v12.52a2.66 2.66 0 1 1-1.82-2.52V9.5a5.86 5.86 0 1 0 5 5.8V8.95a7.82 7.82 0 0 0 4.58 1.47V7.24a4.67 4.67 0 0 1-3.42-1.42Z" />
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="bg-[#1f110c]">
      <div class="mx-auto flex max-w-[76rem] flex-col gap-4 px-4 py-6 text-sm text-brand-paper/70 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <p class="text-left">
          &copy; {new Date().getFullYear()} Cap i Cua Pet Store. Todos los derechos reservados.
        </p>
        <div class="flex flex-wrap gap-4 text-left sm:justify-end sm:text-right">
          <a href="/aviso-legal" class="text-brand-paper transition-colors hover:text-brand-yellow">Aviso Legal</a>
          <a href="/politica-privacidad" class="text-brand-paper transition-colors hover:text-brand-yellow">Política de privacidad</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const nav = document.querySelector('[data-main-nav]');
    const hero = document.querySelector('#hero');
    const scrollUpButton = document.querySelector('[data-scroll-up]');
    const menuToggle = document.querySelector('[data-menu-toggle]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');

    if (menuToggle && mobileMenu) {
      const setMenuOpen = (isOpen) => {
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
        mobileMenu.hidden = false;
        mobileMenu.classList.toggle('pointer-events-none', !isOpen);
        mobileMenu.classList.toggle('scale-95', !isOpen);
        mobileMenu.classList.toggle('opacity-0', !isOpen);
        mobileMenu.classList.toggle('scale-100', isOpen);
        mobileMenu.classList.toggle('opacity-100', isOpen);
        if (!isOpen) {
          window.setTimeout(() => {
            if (menuToggle.getAttribute('aria-expanded') === 'false') {
              mobileMenu.hidden = true;
            }
          }, 200);
        }
      };

      menuToggle.addEventListener('click', () => {
        setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
      });

      mobileMenu.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) {
          setMenuOpen(false);
        }
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMenuOpen(false);
        }
      });

      window.addEventListener('resize', () => {
        if (window.matchMedia('(min-width: 640px)').matches) {
          setMenuOpen(false);
        }
      });
    }

    if (nav && hero) {
      const updateNav = () => {
        const heroBottom = hero.getBoundingClientRect().bottom;
        const hasPassedHero = heroBottom <= nav.clientHeight;

        if (scrollUpButton) {
          scrollUpButton.classList.toggle('pointer-events-none', !hasPassedHero);
          scrollUpButton.classList.toggle('opacity-0', !hasPassedHero);
          scrollUpButton.classList.toggle('opacity-100', hasPassedHero);
        }
      };

      updateNav();
      window.addEventListener('scroll', updateNav, { passive: true });
      window.addEventListener('resize', updateNav);
    }
  </script>

  <style>
    [data-menu-line] {
      transform-box: fill-box;
      transform-origin: center;
      transition: transform 220ms ease, opacity 160ms ease;
    }

    [data-menu-toggle][aria-expanded='true'] [data-menu-line='top'] {
      transform: translateY(5px) rotate(45deg);
    }

    [data-menu-toggle][aria-expanded='true'] [data-menu-line='middle'] {
      opacity: 0;
      transform: scaleX(0.35);
    }

    [data-menu-toggle][aria-expanded='true'] [data-menu-line='bottom'] {
      transform: translateY(-5px) rotate(-45deg);
    }

    .mobile-menu-link::before,
    .mobile-menu-link::after {
      background: radial-gradient(transparent, rgba(255, 255, 255, 0.94));
    }

    .mobile-menu-link:hover::before,
    .mobile-menu-link:hover::after {
      opacity: 0.96;
    }
  </style>
</Layout>
